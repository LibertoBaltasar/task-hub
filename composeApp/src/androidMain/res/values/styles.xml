<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme (light, no action bar) -->
    <style name="Theme.TaskHub" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Dark splash theme — prevents white flash on cold start in dark mode -->
    <style name="Theme.TaskHub.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>
</resources>