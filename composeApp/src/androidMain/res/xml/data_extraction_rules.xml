<?xml version="1.0" encoding="utf-8"?>
<!--
  Equivalente a backup_rules.xml para Android 12+ (android:dataExtractionRules),
  que sustituye a fullBackupContent en API 31+. Ver backup_rules.xml para el
  motivo: excluye las SharedPreferences (tokens de Firebase/Google Calendar)
  tanto de la copia de seguridad en la nube como de la transferencia
  dispositivo-a-dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
