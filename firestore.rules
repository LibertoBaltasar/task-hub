rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    //  Task Hub — Reglas de seguridad (v3 — NO DESPLEGADO)
    //
    //  ⚠️ Este archivo se editó como parte de la auditoría de
    //  2026-08-30 (ver docs/audit-2026-08-30.md) pero NO se ha
    //  desplegado a Firebase — hazlo manualmente (PATCH, no POST,
    //  ver CLAUDE.md) tras revisar el impacto en la UI descrito abajo.
    //
    //  Cambios respecto a v2 (cierran huecos encontrados en la auditoría):
    //   - members/{mid}: antes CUALQUIER miembro podía update/delete el
    //     documento de CUALQUIER otro miembro sin restricción de campos,
    //     así que un perfil "child" podía auto-ascenderse a "role: admin"
    //     o forjar su propio totalPoints/streak vía REST directo. Ahora
    //     un miembro normal solo puede tocar SU PROPIO documento y nunca
    //     su campo `role`; cambiar el rol de otro requiere ser admin/owner.
    //   - members/{mid} (auto-alta con código de invitación): antes no
    //     validaba el resto de campos del documento nuevo, permitiendo
    //     unirse con totalPoints arbitrario. Ahora exige contadores en 0
    //     y que `userId` coincida con el UID que se está creando (evita
    //     que alguien se auto-registre suplantando el userId de otro
    //     usuario, lo que confundiría a resolveCurrentMember()/isMember()
    //     del lado del cliente). El rol SÍ puede elegirse libremente
    //     ("child" o "admin") porque JoinHouseholdScreen.kt lo permite
    //     explícitamente (p. ej. el segundo progenitor uniéndose como
    //     admin a un hogar ya creado) — restringir a solo "child" aquí
    //     rompería ese flujo real de la app.
    //   - taskHistory/rewards: antes cualquier miembro podía editar/borrar
    //     el historial (rompe la integridad de puntos/estadísticas) o
    //     crear/editar recompensas (la UI ya restringe esto a admin/owner,
    //     pero la regla no lo hacía cumplir). Ahora solo admin/owner puede
    //     modificar/borrar taskHistory y escribir rewards.
    //   - isMember()/isAdminMember(): antes solo comprobaban exists() sobre
    //     el documento del miembro. Como abandonar un hogar es un soft-delete
    //     (leftAt = now, el documento NUNCA se borra — ver
    //     FirestoreRepository.deleteMember), un ex-miembro conservaba acceso
    //     de lectura/escritura completo al hogar del que se fue, para
    //     siempre. Ahora isMember() exige además leftAt == 0 (con default 0
    //     vía get() para no romper a miembros activos creados antes de que
    //     existiera este campo, que no lo tienen).
    //   - notifications/{nid}: antes cualquier miembro podía marcar como
    //     leída o BORRAR las notificaciones de cualquier OTRO miembro (el
    //     campo memberId no se comprobaba). Ahora solo el propio
    //     destinatario (o admin/owner, para poder gestionar notificaciones
    //     de perfiles "hijo/a" sin cuenta propia) puede modificar/borrar.
    //
    //  Limitación arquitectónica conocida (no resuelta aquí): sin Cloud
    //  Functions no es posible validar en la regla que un incremento de
    //  totalPoints se corresponde con una tarea realmente completada —
    //  un miembro podría seguir editando SU PROPIO totalPoints a mano vía
    //  REST directo. Cerrarlo del todo requeriría mover esa escritura a
    //  un backend/Cloud Function. Ver docs/audit-2026-08-30.md.
    //
    //  IMPORTANTE — impacto en la app actual antes de desplegar:
    //   - `reassignTaskCompletion` (TaskDetailScreen, "cambiar quién hizo
    //     la tarea") escribe en taskHistory; con esta regla solo funciona
    //     si quien lo hace es admin/owner. Si se usa desde miembros no-admin
    //     en producción, gatéalo en la UI antes de desplegar, o relaja esa
    //     regla a isMember(hid).
    //
    //  Modelo de acceso:
    //   - Todo acceso requiere autenticación (request.auth != null).
    //   - Un usuario puede acceder a un hogar solo si es MIEMBRO
    //     (existe un documento members/{uid}) o PROPIETARIO (ownerId).
    //   - Unirse se hace resolviendo invites/{código} y creando el
    //     documento members/{uid} aportando el código válido.
    //
    //  Requisitos de datos (los cumple el cliente):
    //   - households/{id}.ownerId = UID del creador.
    //   - members/{uid}  → miembros vinculados a una cuenta (id = UID).
    //   - members/{auto} → perfiles "hijo/a" sin cuenta (id automático).
    //   - invites/{código} → { householdId } (mapa código → hogar).
    // ══════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }

    function isOwner(hid) {
      return signedIn()
        && request.auth.uid == householdDoc(hid).data.ownerId;
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid))
        // leftAt > 0 = abandonó el hogar (soft-delete, el doc nunca se borra
        // — ver FirestoreRepository.deleteMember). get(..., 0) por defecto:
        // los miembros activos creados antes de este campo no lo tienen.
        && myMemberDoc(hid).data.get('leftAt', 0) == 0;
    }

    function myMemberDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // Miembro con rol "admin" vinculado a una cuenta (distinto del owner).
    function isAdminMember(hid) {
      return isMember(hid) && myMemberDoc(hid).data.role == "admin";
    }

    // "Confía" en owner o admin — son quienes gestionan roles/contenido
    // sensible del hogar en la UI (crear recompensas, cambiar roles, etc.).
    function isTrusted(hid) {
      return isOwner(hid) || isAdminMember(hid);
    }

    // ── users/{uid}: solo el propio usuario ────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── invites/{código}: resolubles por código, nunca listables ──
    match /invites/{code} {
      // get por id: el código actúa como secreto compartido fuera de banda
      allow get: if signedIn();
      allow list: if false;
      // crear/borrar: solo el propietario del hogar referenciado
      allow create: if signedIn()
        && request.auth.uid == householdDoc(request.resource.data.householdId).data.ownerId;
      allow delete: if signedIn()
        && request.auth.uid == householdDoc(resource.data.householdId).data.ownerId;
    }

    // ── households/{hid}: metadatos (name, inviteCode, ownerId…) ──
    match /households/{hid} {
      // get por id: necesario para unirse (tras resolver el código)
      // y para leer tu propio hogar. El ID es aleatorio → no enumerable.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(hid);
    }

    // ── members/{mid} ──────────────────────────────────────────
    match /households/{hid}/members/{mid} {
      allow read: if isMember(hid) || isOwner(hid);

      allow create: if signedIn() && (
          isOwner(hid)
          || isAdminMember(hid)
          // auto-alta: el UID que se crea aporta el código de invitación
          // válido; se fuerza `userId == request.auth.uid` (nadie puede
          // auto-registrarse suplantando el userId de otro usuario) y
          // contadores en 0 para que nadie pueda entrar ya con saldo/racha
          // inventados. El rol SÍ es libre ("child"/"admin"): JoinHouseholdScreen
          // permite elegirlo explícitamente al unirse por código.
          || (request.auth.uid == mid
              && request.resource.data.inviteCode == householdDoc(hid).data.inviteCode
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role in ["child", "admin"]
              && request.resource.data.totalPoints == 0
              && request.resource.data.currentStreak == 0
              && request.resource.data.bestStreak == 0)
        );

      // El dueño del documento (mismo UID) puede actualizar su propio perfil
      // y sus contadores (puntos/rachas/agradecimientos) — así es como el
      // cliente los incrementa hoy sin backend propio — pero NUNCA su
      // `role`: eso solo lo cambia el admin/owner (o el propio abandono,
      // que usa `leftAt` bajo el mismo dueño y tampoco toca `role`).
      allow update: if isTrusted(hid)
        || (
          request.auth.uid == mid
          && request.resource.data.role == resource.data.role
        );
      allow delete: if isTrusted(hid);
    }

    // ── Contenido del hogar ──────────────────────────────────────
    match /households/{hid}/tasks/{tid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    match /households/{hid}/tasks/{tid}/assignments/{aid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    match /households/{hid}/tasks/{tid}/comments/{cid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    // El historial es el registro de auditoría de puntos/estadísticas:
    // cualquier miembro puede CREAR una entrada (se genera al completar una
    // tarea, en su propio dispositivo), pero editar/borrar una entrada ya
    // existente (p.ej. para manipular StatsScreen) se restringe a admin/owner.
    match /households/{hid}/taskHistory/{thid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid);
    }
    // Cada notificación va dirigida a un miembro (`memberId`). Lectura/creación
    // amplias (dashboard familiar), pero modificar/borrar la notificación de
    // OTRO miembro se restringe a admin/owner (necesario para gestionar
    // notificaciones de perfiles "hijo/a" sin cuenta propia) o al propio
    // destinatario.
    match /households/{hid}/notifications/{nid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid)
        || (isMember(hid) && resource.data.memberId == request.auth.uid);
    }
    // La UI ya restringe "crear recompensa" a admin/owner (RewardListScreen);
    // la regla ahora lo hace cumplir también a nivel de datos.
    match /households/{hid}/rewards/{rid} {
      allow read: if isMember(hid) || isOwner(hid);
      allow write: if isTrusted(hid);
    }
    match /households/{hid}/rewardRedemptions/{rrid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid);
    }
    match /households/{hid}/members/{mid}/achievements/{achid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    match /households/{hid}/messages/{mid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
  }
}
