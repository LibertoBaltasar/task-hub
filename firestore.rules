rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    //  Task Hub — Reglas de seguridad (v6 — PENDIENTE DE DESPLIEGUE)
    //
    //  v6 editada 2026-09-02 (encargo "PROPUESTAS panel v4 —
    //  privacidad/seguridad", punto 7: Experto 9 hallazgo #2). NO
    //  desplegada todavía — el despliegue lo hace el coordinador Hermes vía
    //  scripts/deploy_firestore_rules.py.
    //
    //  Cambio v5→v6: la rama de `create` en members/{mid} (tanto
    //  owner/admin como auto-alta por invitación) no validaba
    //  `appreciationGiven`/`appreciationWeekStart`/`leftAt` — un cliente
    //  modificado podía crear ya un miembro con presupuesto de agradecimiento
    //  o antigüedad de semana arbitrarios (saltándose el tope semanal de
    //  [PointsRules.currentAppreciationBudget]), o con `leftAt` != 0 desde el
    //  alta. El cliente real ([MemberRepository.createMember]) siempre manda
    //  appreciationGiven=0/appreciationWeekStart=0 y nunca manda `leftAt` —
    //  ahora la regla lo exige (con default 0 vía get() para el campo que el
    //  cliente no envía).
    //
    //  v5 editada el 2026-09-01 (encargo "privacidad/RGPD + seguridad",
    //  hallazgo M2 del panel de expertos v3 — ver
    //  docs/review-panel-expertos-v3-2026-09-01.md, Experto 9). Desplegada
    //  en producción el 2026-09-01 21:49Z vía scripts/deploy_firestore_rules.py
    //  (PATCH, no POST — ver CLAUDE.md). Ruleset
    //  projects/task-hub-62f98/rulesets/4d5f5625-f24e-40e1-a8b3-954a33715a72
    //  (sustituye al v4 014a2dcd-974a-4dd4-931a-4d8608cdb82c, desplegado 2026-08-31).
    //
    //  Cambio v4→v5 (M2): la rama `isOwner`/`isAdminMember` de `create` en
    //  members/{mid} no validaba los mismos límites que la rama de auto-alta
    //  por invitación — un owner/admin con cliente modificado podía crear un
    //  miembro con `totalPoints`/racha arbitrarios, o con `userId` de OTRA
    //  persona (suplantación). Ahora exige contadores en 0 y que, si se
    //  vincula una cuenta (`userId` no nulo), sea la del propio creador —
    //  cubre los dos usos reales de esta rama (CreateProfileScreen: el
    //  owner crea su propio primer perfil; alta de perfiles "hijo/a" sin
    //  cuenta, con `userId == null`). El rol sigue libre en esta rama a
    //  propósito (owner/admin deben poder fijar/ascender roles).
    //
    //  Historial: v4 se editó como parte del encargo "modelo de roles
    //  seguro" de 2026-08-30 (cierra los 2 bloqueantes de la auditoría
    //  anterior, ver docs/audit-2026-08-30.md) y se completó con el ajuste
    //  de taskHistory delete (propio miembro) del encargo "cierre de
    //  pendientes" 2026-08-31 antes de desplegar.
    //
    //  Ajuste v4 (encargo "cierre de pendientes" 2026-08-31, sección 0):
    //  taskHistory/{thid} `delete` ahora también permite al PROPIO miembro
    //  borrar su registro (memberId == auth.uid), no solo admin/owner.
    //  Motivo: [TaskScreenModel.undoCompleteTask] (deshacer "completar
    //  tarea") lo hace un miembro normal, no un admin — sin este ajuste el
    //  delete (ya best-effort, no rompe el undo) dejaría huérfano para
    //  siempre el registro de taskHistory de cualquier undo hecho por un
    //  miembro no-admin, desincronizando StatsScreen en cuanto se
    //  desplieguen las reglas. `update` de taskHistory sigue restringido a
    //  admin/owner (solo lo usa reassignTaskCompletion, ya gateado en UI).
    //
    //  Cambios respecto a v3 (cierran los 2 bloqueantes que impedían
    //  desplegar v3 — ver "IMPORTANTE" de v3 más abajo):
    //   - members/{mid} (auto-alta con código de invitación): el rol YA
    //     NO es libre. v3 permitía "child" o "admin" porque
    //     JoinHouseholdScreen.kt dejaba elegir; ahora esa pantalla fuerza
    //     "child" siempre (nadie se autoproclama admin al unirse por
    //     código — un admin existente asciende al segundo progenitor
    //     después). Se exige `role == "child"` en la propia regla, no solo
    //     en la UI, para que no se pueda saltar por REST directo.
    //     CreateProfileScreen.kt (crear el PRIMER perfil justo tras crear
    //     el hogar) NO usa esta rama: ese flujo solo es alcanzable siendo
    //     ya `ownerId` del hogar recién creado, así que cae en la rama
    //     `isOwner(hid)` de abajo, que sigue permitiendo elegir rol
    //     libremente (el creador del hogar eligiendo su propio rol).
    //   - households/{hid}/tasks/{tid}: antes cualquier miembro podía
    //     escribir cualquier campo de una tarea, incluido `completedBy`
    //     sin restricción — lo que permitía a un miembro no-admin usar
    //     `reassignTaskCompletion` (REST directo) para robarle a otro
    //     miembro los puntos de una tarea ya completada. Ahora un cambio
    //     de `completedBy` que NO va acompañado de un cambio de
    //     `lastCompletedDate` (la firma de una reasignación: ver
    //     [FirestoreRepository.reassignTaskCompletion], que actualiza
    //     `completedBy` en solitario vía `updateMask`) requiere
    //     admin/owner. Completar una tarea (completeTask) y deshacer un
    //     "hecho" (revertTaskCompletion) SIEMPRE cambian ambos campos a
    //     la vez, así que un miembro normal los sigue pudiendo hacer.
    //
    //  (el resto de esta sección documenta los cambios de v2→v3, aún
    //  vigentes en v4 salvo lo indicado arriba):
    //
    //   - members/{mid}: antes CUALQUIER miembro podía update/delete el
    //     documento de CUALQUIER otro miembro sin restricción de campos,
    //     así que un perfil "child" podía auto-ascenderse a "role: admin"
    //     o forjar su propio totalPoints/streak vía REST directo. Ahora
    //     un miembro normal solo puede tocar SU PROPIO documento y nunca
    //     su campo `role`; cambiar el rol de otro requiere ser admin/owner.
    //   - members/{mid} (auto-alta con código de invitación): antes no
    //     validaba el resto de campos del documento nuevo, permitiendo
    //     unirse con totalPoints arbitrario. Ahora exige contadores en 0
    //     y que `userId` coincida con el UID que se está creando (evita
    //     que alguien se auto-registre suplantando el userId de otro
    //     usuario, lo que confundiría a resolveCurrentMember()/isMember()
    //     del lado del cliente). [en v3 el rol era libre aquí; en v4 se
    //     fuerza a "child" — ver el bloque de cambios v3→v4 más arriba]
    //   - taskHistory/rewards: antes cualquier miembro podía editar/borrar
    //     el historial (rompe la integridad de puntos/estadísticas) o
    //     crear/editar recompensas (la UI ya restringe esto a admin/owner,
    //     pero la regla no lo hacía cumplir). Ahora solo admin/owner puede
    //     modificar/borrar taskHistory y escribir rewards.
    //   - isMember()/isAdminMember(): antes solo comprobaban exists() sobre
    //     el documento del miembro. Como abandonar un hogar es un soft-delete
    //     (leftAt = now, el documento NUNCA se borra — ver
    //     FirestoreRepository.deleteMember), un ex-miembro conservaba acceso
    //     de lectura/escritura completo al hogar del que se fue, para
    //     siempre. Ahora isMember() exige además leftAt == 0 (con default 0
    //     vía get() para no romper a miembros activos creados antes de que
    //     existiera este campo, que no lo tienen).
    //   - notifications/{nid}: antes cualquier miembro podía marcar como
    //     leída o BORRAR las notificaciones de cualquier OTRO miembro (el
    //     campo memberId no se comprobaba). Ahora solo el propio
    //     destinatario (o admin/owner, para poder gestionar notificaciones
    //     de perfiles "hijo/a" sin cuenta propia) puede modificar/borrar.
    //
    //  Limitación arquitectónica conocida (no resuelta aquí): sin Cloud
    //  Functions no es posible validar en la regla que un incremento de
    //  totalPoints se corresponde con una tarea realmente completada —
    //  un miembro podría seguir editando SU PROPIO totalPoints a mano vía
    //  REST directo. Cerrarlo del todo requeriría mover esa escritura a
    //  un backend/Cloud Function. Ver docs/audit-2026-08-30.md.
    //
    //  Los 2 bloqueantes de v3 (`reassignTaskCompletion` sin gatear por rol
    //  y el selector libre de rol "Admin" al unirse) están resueltos en v4
    //  tanto en la UI (TaskDetailScreen/HouseholdMemberList/JoinHouseholdScreen)
    //  como en estas reglas — ver el bloque de cambios v3→v4 más arriba.
    //
    //  Modelo de acceso:
    //   - Todo acceso requiere autenticación (request.auth != null).
    //   - Un usuario puede acceder a un hogar solo si es MIEMBRO
    //     (existe un documento members/{uid}) o PROPIETARIO (ownerId).
    //   - Unirse se hace resolviendo invites/{código} y creando el
    //     documento members/{uid} aportando el código válido.
    //
    //  Requisitos de datos (los cumple el cliente):
    //   - households/{id}.ownerId = UID del creador.
    //   - members/{uid}  → miembros vinculados a una cuenta (id = UID).
    //   - members/{auto} → perfiles "hijo/a" sin cuenta (id automático).
    //   - invites/{código} → { householdId } (mapa código → hogar).
    // ══════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }

    function isOwner(hid) {
      return signedIn()
        && request.auth.uid == householdDoc(hid).data.ownerId;
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid))
        // leftAt > 0 = abandonó el hogar (soft-delete, el doc nunca se borra
        // — ver FirestoreRepository.deleteMember). get(..., 0) por defecto:
        // los miembros activos creados antes de este campo no lo tienen.
        && myMemberDoc(hid).data.get('leftAt', 0) == 0;
    }

    function myMemberDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // Miembro con rol "admin" vinculado a una cuenta (distinto del owner).
    function isAdminMember(hid) {
      return isMember(hid) && myMemberDoc(hid).data.role == "admin";
    }

    // "Confía" en owner o admin — son quienes gestionan roles/contenido
    // sensible del hogar en la UI (crear recompensas, cambiar roles, etc.).
    function isTrusted(hid) {
      return isOwner(hid) || isAdminMember(hid);
    }

    // ── users/{uid}: solo el propio usuario ────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── invites/{código}: resolubles por código, nunca listables ──
    match /invites/{code} {
      // get por id: el código actúa como secreto compartido fuera de banda
      allow get: if signedIn();
      allow list: if false;
      // crear/borrar: solo el propietario del hogar referenciado
      allow create: if signedIn()
        && request.auth.uid == householdDoc(request.resource.data.householdId).data.ownerId;
      allow delete: if signedIn()
        && request.auth.uid == householdDoc(resource.data.householdId).data.ownerId;
    }

    // ── households/{hid}: metadatos (name, inviteCode, ownerId…) ──
    match /households/{hid} {
      // get por id: necesario para unirse (tras resolver el código)
      // y para leer tu propio hogar. El ID es aleatorio → no enumerable.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(hid);
    }

    // ── members/{mid} ──────────────────────────────────────────
    match /households/{hid}/members/{mid} {
      allow read: if isMember(hid) || isOwner(hid);

      allow create: if signedIn() && (
          // owner/admin (p.ej. CreateProfileScreen: el owner crea su propio
          // primer perfil; alta de perfiles "hijo/a" sin cuenta): el rol
          // sigue libre (deben poder fijar/ascender roles), pero el
          // documento nuevo tampoco puede traer ya saldo/racha inventados
          // ni un `userId` que suplante a otra persona — si se vincula una
          // cuenta, tiene que ser la del propio creador (único caso real
          // hoy; los perfiles "hijo/a" usan userId == null). Ver M2 del
          // panel de seguridad v3 (docs/review-panel-expertos-v3-2026-09-01.md).
          (
            (isOwner(hid) || isAdminMember(hid))
            && request.resource.data.totalPoints == 0
            && request.resource.data.currentStreak == 0
            && request.resource.data.bestStreak == 0
            // Mismo tope que la rama de auto-alta de abajo: sin esto, un
            // owner/admin con cliente modificado podía crear ya un miembro
            // con presupuesto de agradecimiento semanal consumido/manipulado
            // o marcado como "abandonado" desde el alta (panel v4, Experto 9
            // hallazgo #2). get(..., 0): el cliente real nunca manda `leftAt`
            // al crear.
            && request.resource.data.get('appreciationGiven', 0) == 0
            && request.resource.data.get('appreciationWeekStart', 0) == 0
            && request.resource.data.get('leftAt', 0) == 0
            && (
              request.resource.data.get('userId', null) == null
              || request.resource.data.userId == request.auth.uid
            )
          )
          // auto-alta: el UID que se crea aporta el código de invitación
          // válido; se fuerza `userId == request.auth.uid` (nadie puede
          // auto-registrarse suplantando el userId de otro usuario) y
          // contadores en 0 para que nadie pueda entrar ya con saldo/racha
          // inventados. El rol se fuerza a "child" (nombre de display
          // "Miembro" — ver AppStrings, el valor interno NO cambia): nadie
          // se autoproclama admin al unirse por código, un admin/owner
          // existente asciende a quien haga falta después (ver el `update`
          // de más abajo). JoinHouseholdScreen.kt ya no ofrece selector.
          || (request.auth.uid == mid
              && request.resource.data.inviteCode == householdDoc(hid).data.inviteCode
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == "child"
              && request.resource.data.totalPoints == 0
              && request.resource.data.currentStreak == 0
              && request.resource.data.bestStreak == 0
              && request.resource.data.get('appreciationGiven', 0) == 0
              && request.resource.data.get('appreciationWeekStart', 0) == 0
              && request.resource.data.get('leftAt', 0) == 0)
        );

      // El dueño del documento (mismo UID) puede actualizar su propio perfil
      // y sus contadores (puntos/rachas/agradecimientos) — así es como el
      // cliente los incrementa hoy sin backend propio — pero NUNCA su
      // `role`: eso solo lo cambia el admin/owner (o el propio abandono,
      // que usa `leftAt` bajo el mismo dueño y tampoco toca `role`).
      allow update: if isTrusted(hid)
        || (
          request.auth.uid == mid
          && request.resource.data.role == resource.data.role
        );
      // El propio dueño del documento también puede borrarlo — es la ruta que
      // usa [FirestoreRepository.leaveHousehold] (abandonar hogar / eliminar
      // cuenta) para borrar SU PROPIO miembro. Sin esta cláusula, cualquier
      // miembro con rol "child" (el que fuerza el alta por invitación más
      // arriba) recibía 403 al intentar salir de un hogar compartido o al
      // eliminar su cuenta, y el fallo se tragaba en silencio en el cliente
      // (best-effort) — v4 panel de expertos, Experto 10 hallazgo #1 CRÍTICO.
      allow delete: if isTrusted(hid) || request.auth.uid == mid;
    }

    // ── Contenido del hogar ──────────────────────────────────────
    // Cualquier miembro puede leer/crear/borrar tareas y editar sus campos
    // habituales (título, puntos, subtareas…) igual que antes. La excepción
    // es reasignar `completedBy` de una tarea YA completada a otra persona
    // sin tocar `lastCompletedDate` (la firma de
    // [FirestoreRepository.reassignTaskCompletion], que solo toca ese
    // campo vía `updateMask`) — eso mueve puntos de un miembro a otro y
    // ahora requiere admin/owner. Completar (completeTask) y deshacer
    // (revertTaskCompletion) cambian `completedBy` Y `lastCompletedDate`
    // juntos, así que no caen en esta restricción.
    match /households/{hid}/tasks/{tid} {
      allow read, create, delete: if isMember(hid) || isOwner(hid);
      allow update: if isTrusted(hid)
        || (
          (isMember(hid) || isOwner(hid))
          && !(
            request.resource.data.get('completedBy', null) != resource.data.get('completedBy', null)
            && request.resource.data.get('lastCompletedDate', null) == resource.data.get('lastCompletedDate', null)
          )
        );
    }
    match /households/{hid}/tasks/{tid}/assignments/{aid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    match /households/{hid}/tasks/{tid}/comments/{cid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    // El historial es el registro de auditoría de puntos/estadísticas:
    // cualquier miembro puede CREAR una entrada (se genera al completar una
    // tarea, en su propio dispositivo), pero editar/borrar una entrada ya
    // existente (p.ej. para manipular StatsScreen) se restringe a admin/owner.
    match /households/{hid}/taskHistory/{thid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update: if isTrusted(hid);
      // delete: admin/owner puede borrar cualquier registro; además, el
      // propio miembro puede borrar SU PROPIO registro (memberId ==
      // auth.uid) — necesario para [TaskScreenModel.undoCompleteTask]:
      // deshacer "completar tarea" es una acción de miembro normal que
      // borra el registro de la propia compleción para no dejar
      // taskHistory desincronizado con totalPoints (ver
      // FirestoreRepository.deleteTaskHistoryRecord). Sigue sin permitir
      // borrar el registro de OTRO miembro sin ser admin/owner.
      allow delete: if isTrusted(hid)
        || (isMember(hid) && resource.data.memberId == request.auth.uid);
    }
    // Cada notificación va dirigida a un miembro (`memberId`). Lectura/creación
    // amplias (dashboard familiar), pero modificar/borrar la notificación de
    // OTRO miembro se restringe a admin/owner (necesario para gestionar
    // notificaciones de perfiles "hijo/a" sin cuenta propia) o al propio
    // destinatario.
    match /households/{hid}/notifications/{nid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid)
        || (isMember(hid) && resource.data.memberId == request.auth.uid);
    }
    // La UI ya restringe "crear recompensa" a admin/owner (RewardListScreen);
    // la regla ahora lo hace cumplir también a nivel de datos.
    match /households/{hid}/rewards/{rid} {
      allow read: if isMember(hid) || isOwner(hid);
      allow write: if isTrusted(hid);
    }
    match /households/{hid}/rewardRedemptions/{rrid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid);
    }
    match /households/{hid}/members/{mid}/achievements/{achid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    match /households/{hid}/messages/{mid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
  }
}
