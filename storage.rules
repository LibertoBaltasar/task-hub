rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ══════════════════════════════════════════════════════════
    //  Task Hub — Reglas de Storage (v1)
    //
    //  Modelo de acceso (equivalente a firestore.rules):
    //   - Todo acceso requiere autenticación (request.auth != null).
    //   - Los avatares viven en avatars/{uid}/... → cada usuario
    //     escribe SOLO en su propia carpeta.
    //   - Lectura abierta a cualquier usuario autenticado (para que
    //     los demás miembros del hogar vean la foto).
    // ══════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    match /avatars/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
